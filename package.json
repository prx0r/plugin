{
  "name": "print",
  "private": true,
  "version": "0.1.0",
  "description": "AgentCom — real-world markets callable by AI agents. Monorepo: canonical router kernel, verticals (domains, print), MCP surfaces, evals, intel.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/providers/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node --test tests/*.mjs",
    "typecheck": "tsc --noEmit",
    "mcp": "node apps/mcp/src/server.ts",
    "studio": "node packages/studio/src/cli.ts",
    "preflight:domains": "python3 kits/plugin-canonical/agentcom_plugin_canonical/checks/plugin_lint.py submissions/domains/plugin_spec.json",
    "preflight:schema": "python3 kits/plugin-canonical/agentcom_plugin_canonical/checks/validate_schema.py submissions/domains/plugin_spec.json"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
