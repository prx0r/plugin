# Stripe Configuration
# Get your secret key from: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for development, live keys (sk_live_...) for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# MCP Server Base URL
# Required for production deployments. Used for widget URLs and CSP configuration.
# For local development, defaults to http://localhost:3000
MCP_URL=http://localhost:3000

# Content Security Policy URLs (Optional)
# Additional domains to whitelist in widget Content Security Policy.
# Required for static deployments where widgets are served from different domains.
# Supports comma-separated list.
# Example: CSP_URLS=https://your-domain.com,https://cdn.example.com
CSP_URLS=
