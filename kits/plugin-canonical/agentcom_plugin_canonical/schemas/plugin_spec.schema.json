{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentCom Plugin Preflight Spec",
  "type": "object",
  "required": [
    "app",
    "mcp",
    "tools",
    "tests",
    "publisher",
    "privacy",
    "third_party_integrations"
  ],
  "properties": {
    "app": {
      "type": "object",
      "required": [
        "name",
        "subtitle",
        "description",
        "category",
        "commerce",
        "has_ui"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 30
        },
        "subtitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 30
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 4000
        },
        "category": {
          "type": "string"
        },
        "commerce": {
          "enum": [
            "none",
            "physical_goods",
            "digital_goods_or_services"
          ]
        },
        "has_ui": {
          "type": "boolean"
        },
        "serves_ads": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "starter_prompts": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "demo_recording_url": {
          "type": "string"
        },
        "release_notes": {
          "type": "string"
        }
      }
    },
    "publisher": {
      "type": "object",
      "required": [
        "verified_identity",
        "identity_name_matches_public_urls",
        "website_url",
        "support_url",
        "privacy_url",
        "terms_url"
      ],
      "properties": {
        "verified_identity": {
          "type": "boolean"
        },
        "identity_name_matches_public_urls": {
          "type": "boolean"
        },
        "website_url": {
          "type": "string"
        },
        "support_url": {
          "type": "string"
        },
        "privacy_url": {
          "type": "string"
        },
        "terms_url": {
          "type": "string"
        }
      }
    },
    "mcp": {
      "type": "object",
      "required": [
        "url",
        "public_production",
        "url_type"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "public_production": {
          "type": "boolean"
        },
        "url_type": {
          "enum": [
            "Universal",
            "Template"
          ]
        },
        "auth_required": {
          "type": "boolean"
        },
        "review_account_no_mfa": {
          "type": "boolean"
        },
        "domain_verified": {
          "type": "boolean"
        },
        "scan_current": {
          "type": "boolean"
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "policy_covers_categories",
        "policy_covers_purposes",
        "policy_covers_recipients",
        "policy_covers_retention",
        "policy_covers_controls"
      ],
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "connect_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frame_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redirect_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "widget_uri_versioned": {
          "type": "boolean"
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "inputs",
          "outputs",
          "annotations",
          "behavior",
          "annotation_justifications"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "required"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "returns_structured_content": {
            "type": "boolean"
          },
          "has_output_schema": {
            "type": "boolean"
          },
          "annotations": {
            "type": "object",
            "required": [
              "readOnlyHint",
              "openWorldHint",
              "destructiveHint"
            ],
            "properties": {
              "readOnlyHint": {
                "type": "boolean"
              },
              "openWorldHint": {
                "type": "boolean"
              },
              "destructiveHint": {
                "type": "boolean"
              },
              "idempotentHint": {
                "type": "boolean"
              }
            }
          },
          "behavior": {
            "type": "object",
            "required": [
              "mutates_state",
              "accesses_public_or_open_ended_external_entities",
              "irreversible_or_hard_to_reverse",
              "sends_data_to_third_party"
            ],
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "annotation_justifications": {
            "type": "object",
            "required": [
              "readOnlyHint",
              "openWorldHint",
              "destructiveHint"
            ],
            "properties": {
              "readOnlyHint": {
                "type": "string",
                "minLength": 12
              },
              "openWorldHint": {
                "type": "string",
                "minLength": 12
              },
              "destructiveHint": {
                "type": "string",
                "minLength": 12
              },
              "idempotentHint": {
                "type": "string",
                "minLength": 12
              }
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "required": [
        "positive",
        "negative"
      ],
      "properties": {
        "positive": {
          "type": "array"
        },
        "negative": {
          "type": "array"
        }
      }
    },
    "third_party_integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "authorized",
          "official_api_or_partner_access",
          "terms_reviewed",
          "primary_pass_through"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "authorized": {
            "type": "boolean"
          },
          "official_api_or_partner_access": {
            "type": "boolean"
          },
          "terms_reviewed": {
            "type": "boolean"
          },
          "primary_pass_through": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
