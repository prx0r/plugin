  "tools": [
    {
      "name": "check_domain_availability",
      "description": "Check whether an exact domain name is currently available to register. Use when the user asks whether a specific domain is available; do not use for general naming advice without an availability request.",
      "inputs": [
        {
          "name": "domain",
          "type": "string",
          "required": true,
          "description": "Exact fully-qualified domain to check."
        }
      ],
      "outputs": [
        "domain",
        "available",
        "status",
        "checked_at",
        "registrar_options"
      ],
      "returns_structured_content": true,
      "has_output_schema": true,
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "behavior": {
        "mutates_state": false,
        "accesses_public_or_open_ended_external_entities": true,
        "irreversible_or_hard_to_reverse": false,
        "sends_data_to_third_party": true
      },
      "annotation_justifications": {
        "readOnlyHint": "True because this tool only reads current domain registration status and does not mutate user or external state.",
        "openWorldHint": "True because this tool queries live public domain-registration infrastructure outside ChatGPT.",
        "destructiveHint": "False because availability checks do not delete, overwrite, cancel, charge, or irreversibly modify anything.",
        "idempotentHint": "True because repeating the same availability lookup has no additional side effect."
      }
    }
  ],
