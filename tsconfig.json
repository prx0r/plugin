{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/providers/*/src/**/*.ts",
    "capabilities/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/mcp/src/remote-server.ts"
  ]
}
